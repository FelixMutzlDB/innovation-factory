# Innovation Factory — local-dev environment template
#
# Copy this file to .env and fill in (or unset) values for your workspace.
# .env is gitignored; .env.example IS checked in and is the source of truth
# for which env vars the app reads.
#
# Loading order (highest priority first):
#   1. Process env vars (CI / shell exports)
#   2. .env (apx auto-loads via python-dotenv)
#   3. databricks.yml `targets.<target>.config.env` (deploy-only)
#   4. app.yml `env:` (deploy-only)


# ---------------------------------------------------------------------------
# Auth + workspace
# ---------------------------------------------------------------------------
# CLI profile to use for local dev. `apx dev start` picks this up.
DATABRICKS_CONFIG_PROFILE=fevm-felix-demo


# ---------------------------------------------------------------------------
# Database (LOCAL DEV)
# ---------------------------------------------------------------------------
# Three options, in priority order — set ONE of these blocks.
#
# OPTION A — local PGlite (default for `apx dev start`). Leave both
# DATABASE_URL and PGHOST UNSET; apx provides APX_DEV_DB_PORT/PWD at runtime.
#
# OPTION B — direct connection to a remote Postgres (Lakebase or otherwise).
#   DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
#
# OPTION C — Lakebase Autoscaling via PGHOST/ENDPOINT_NAME (production parity).
#   PGHOST=ep-xxx.database.us-west-2.cloud.databricks.com
#   PGDATABASE=databricks_postgres
#   PGUSER=your.email@databricks.com
#   PGPORT=5432
#   PGSSLMODE=require
#   ENDPOINT_NAME=projects/innovation-factory/branches/production/endpoints/primary


# ---------------------------------------------------------------------------
# Lakehouse — shared
# ---------------------------------------------------------------------------
WAREHOUSE_ID=f7cdb11888c4799e
UC_CATALOG=felix_demo_catalog


# ---------------------------------------------------------------------------
# Idea Generator (platform-level)
# ---------------------------------------------------------------------------
IDEA_GENERATOR_ENDPOINT=t2t-f9df30eb-endpoint


# ---------------------------------------------------------------------------
# Per-accelerator resource IDs
# Source of truth: scripts/fevm_agents_state.json after a successful
# `python scripts/bootstrap.py`. The block between AECO_AUTOGEN_BEGIN /
# AECO_AUTOGEN_END below is regenerated by
# `python scripts/sync_env_from_state.py` — don't hand-edit inside.
# ---------------------------------------------------------------------------

# --- MOL ASM Cockpit (manual — no MAS / dashboard yet, kept here for completeness) ---
MAC_DASHBOARD_ID=
MAC_MAS_ENDPOINT_NAME=
MAC_UC_SCHEMA=mac

# --- Per-accelerator schemas (stable, manual) ---
ADTECH_UC_SCHEMA=adtech_intelligence
HB_UC_SCHEMA=hb_product_center
AECO_UC_SCHEMA=aeco_hub

# AECO_AUTOGEN_BEGIN: resource-ids
ADTECH_DASHBOARD_ID=01f13f258d20183894ba2b942833b50e

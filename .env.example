# HB Vector Search (CLIP image recognition — used by services/uc_query_service.py)
# Unprefixed because the CLIP/VS pipeline pre-dates the per-project prefix
# convention. Reachable across HB-Product-Center only.
IMAGE_VOLUME_PATH=/Volumes/innovation_factory_catalog/hb_product_center/images
VS_ENDPOINT_NAME=hb-product-center-vs-endpoint
VS_INDEX_NAME=innovation_factory_catalog.hb_product_center.product_image_index
VS_IMAGE_TABLE=innovation_factory_catalog.hb_product_center.product_image_embeddings
